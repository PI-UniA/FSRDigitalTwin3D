    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ConceptualSocialAbility</IRI>
        <Literal>Conceptual social abilites as part of an agent&apos;s capability. As of now, the ontology follows the seven social abilites identified by Heerink et al. (2006)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#EmotionVector</IRI>
        <Literal>A class for the representation of emotions as a vector of scalar values.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#FacialExpression</IRI>
        <Literal>Disjoint facial expressions. If one is identified as the truth, the others do not comply!</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SocialAbility</IRI>
        <Literal>Social abilites as part of an agent&apos;s capability.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SocialEntitySet</IRI>
        <Literal>Represents statistical values over a collection of entities with some defined form of social relevancy</Literal>
    </AnnotationAssertion>
