@prefix : <http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial/> .

<http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasBase
:hasBase rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :hasIngredient ;
         owl:inverseOf :isBaseOf ;
         rdfs:domain :Pizza ;
         rdfs:range :PizzaBase .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasSpiciness
:hasSpiciness rdf:type owl:ObjectProperty ;
              rdfs:domain :PizzaTopping ;
              rdfs:range :Spiciness .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping
:hasTopping rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasIngredient ;
            owl:inverseOf :isToppingOf ;
            rdfs:domain :Pizza ;
            rdfs:range :PizzaTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isBaseOf
:isBaseOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isIngredientOf .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isIngredientOf
:isIngredientOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isMilderThan
:isMilderThan rdf:type owl:ObjectProperty ;
              owl:inverseOf :isSpicierThan .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isSpicierThan
:isSpicierThan rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain :Spiciness ;
               rdfs:range :Spiciness .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isToppingOf
:isToppingOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isIngredientOf .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasCaloricContent
:hasCaloricContent rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Pizza ;
                   rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AmericanaHotPizza
:AmericanaHotPizza rdf:type owl:Class ;
                   rdfs:subClassOf :NamedPizza ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasTopping ;
                                     owl:someValuesFrom :JalapenoPepperTopping
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasTopping ;
                                     owl:someValuesFrom :MozzarellaTopping
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasTopping ;
                                     owl:someValuesFrom :PepperoniTopping
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasTopping ;
                                     owl:someValuesFrom :TomatoTopping
                                   ] ;
                   rdfs:comment "A pizza that only has Mozzarella and Tomato, and Pepperoni toppings" .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AmericanaPizza
:AmericanaPizza rdf:type owl:Class ;
                rdfs:subClassOf :NamedPizza ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasTopping ;
                                  owl:someValuesFrom :MozzarellaTopping
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasTopping ;
                                  owl:someValuesFrom :PepperoniTopping
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasTopping ;
                                  owl:someValuesFrom :TomatoTopping
                                ] ;
                rdfs:comment "A pizza that only has Mozzarella and Tomato, and Pepperoni toppings" .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AnchovyTopping
:AnchovyTopping rdf:type owl:Class ;
                rdfs:subClassOf :SeafoodTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CaperTopping
:CaperTopping rdf:type owl:Class ;
              rdfs:subClassOf :VegetableTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheeseTopping
:CheeseTopping rdf:type owl:Class ;
               rdfs:subClassOf :PizzaTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheesyPizza
:CheesyPizza rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :hasTopping ;
                                                          owl:someValuesFrom :CheeseTopping
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#GreenPepperTopping
:GreenPepperTopping rdf:type owl:Class ;
                    rdfs:subClassOf :PepperTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#HamTopping
:HamTopping rdf:type owl:Class ;
            rdfs:subClassOf :MeatTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#HighCaloriePizza
:HighCaloriePizza rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasCaloricContent ;
                                                               owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                    owl:onDatatype xsd:integer ;
                                                                                    owl:withRestrictions ( [ xsd:minInclusive 400
                                                                                                           ]
                                                                                                         )
                                                                                  ]
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#InterestingPizza
:InterestingPizza rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasTopping ;
                                                               owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                                                               owl:onClass :PizzaTopping
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#JalapenoPepperTopping
:JalapenoPepperTopping rdf:type owl:Class ;
                       rdfs:subClassOf :PepperTopping ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasSpiciness ;
                                         owl:hasValue :Hot
                                       ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#LowCaloriePizza
:LowCaloriePizza rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasCaloricContent ;
                                                              owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                   owl:onDatatype xsd:integer ;
                                                                                   owl:withRestrictions ( [ xsd:maxExclusive 400
                                                                                                          ]
                                                                                                        )
                                                                                 ]
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MargheritaPizza
:MargheritaPizza rdf:type owl:Class ;
                 rdfs:subClassOf :NamedPizza ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:someValuesFrom :MozzarellaTopping
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:someValuesFrom :TomatoTopping
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                       owl:unionOf ( :MozzarellaTopping
                                                                     :TomatoTopping
                                                                   )
                                                     ]
                                 ] ;
                 rdfs:comment "A pizza that only has Mozzarella and Tomato toppings" .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MeatTopping
:MeatTopping rdf:type owl:Class ;
             rdfs:subClassOf :PizzaTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MozzarellaTopping
:MozzarellaTopping rdf:type owl:Class ;
                   rdfs:subClassOf :CheeseTopping ;
                   owl:disjointWith :ParmesanTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MushroomTopping
:MushroomTopping rdf:type owl:Class ;
                 rdfs:subClassOf :VegetableTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#NamedPizza
:NamedPizza rdf:type owl:Class ;
            rdfs:subClassOf :Pizza .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#OliveTopping
:OliveTopping rdf:type owl:Class ;
              rdfs:subClassOf :VegetableTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#ParmesanTopping
:ParmesanTopping rdf:type owl:Class ;
                 rdfs:subClassOf :CheeseTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PepperTopping
:PepperTopping rdf:type owl:Class ;
               rdfs:subClassOf :VegetableTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PepperoniTopping
:PepperoniTopping rdf:type owl:Class ;
                  rdfs:subClassOf :MeatTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza
:Pizza rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasBase ;
                         owl:someValuesFrom :PizzaBase
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasCaloricContent ;
                         owl:someValuesFrom xsd:integer
                       ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PizzaBase
:PizzaBase rdf:type owl:Class .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PizzaTopping
:PizzaTopping rdf:type owl:Class .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PrawnTopping
:PrawnTopping rdf:type owl:Class ;
              rdfs:subClassOf :SeafoodTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#RedPepperTopping
:RedPepperTopping rdf:type owl:Class ;
                  rdfs:subClassOf :PepperTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#SalamiTopping
:SalamiTopping rdf:type owl:Class ;
               rdfs:subClassOf :MeatTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#SeafoodTopping
:SeafoodTopping rdf:type owl:Class ;
                rdfs:subClassOf :PizzaTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#SohoPizza
:SohoPizza rdf:type owl:Class ;
           rdfs:subClassOf :NamedPizza ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :MozzarellaTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :OliveTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :ParmesanTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:someValuesFrom :TomatoTopping
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasTopping ;
                             owl:allValuesFrom [ rdf:type owl:Class ;
                                                 owl:unionOf ( :MozzarellaTopping
                                                               :OliveTopping
                                                               :ParmesanTopping
                                                               :TomatoTopping
                                                             )
                                               ]
                           ] ;
           rdfs:comment "A pizza that only has Mozzarella and Tomato toppings" .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Spiciness
:Spiciness rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:oneOf ( :Hot
                                             :Medium
                                             :Mild
                                           )
                               ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#SpicyBeedTopping
:SpicyBeedTopping rdf:type owl:Class ;
                  rdfs:subClassOf :MeatTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#SpicyPizza
:SpicyPizza rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasTopping ;
                                                         owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :hasSpiciness ;
                                                                              owl:hasValue :Hot
                                                                            ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#TomatoTopping
:TomatoTopping rdf:type owl:Class ;
               rdfs:subClassOf :VegetableTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#TunaTopping
:TunaTopping rdf:type owl:Class ;
             rdfs:subClassOf :SeafoodTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#VegetableTopping
:VegetableTopping rdf:type owl:Class ;
                  rdfs:subClassOf :PizzaTopping .


###  http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#VegetarianPizza
:VegetarianPizza rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasTopping ;
                                                              owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                  owl:unionOf ( :CheeseTopping
                                                                                                :VegetableTopping
                                                                                              )
                                                                                ]
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


