@prefix : <https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#> .

<https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots> rdf:type owl:Ontology ;
                                                                                                             owl:versionIRI <https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots/0.0.0> ;
                                                                                                             owl:imports <http://pst.istc.cnr.it/ontologies/2019/01/soho/1.0.0> .

#################################################################
#    Classes
#################################################################

###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#AngryFacialExpression
:AngryFacialExpression rdf:type owl:Class ;
                       rdfs:subClassOf :FacialExpression .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#CognitiveSocialParameter
:CognitiveSocialParameter rdf:type owl:Class ;
                          rdfs:subClassOf :IntrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ConceptualSocialAbility
:ConceptualSocialAbility rdf:type owl:Class ;
                         rdfs:subClassOf :SocialAbility ;
                         rdfs:comment "Conceptual social abilites as part of an agent's capability. As of now, the ontology follows the seven social abilites identified by Heerink et al. (2006)" .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ConcreteSocialAbility
:ConcreteSocialAbility rdf:type owl:Class ;
                       rdfs:subClassOf :SocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#CooperativeSocialAbility
:CooperativeSocialAbility rdf:type owl:Class ;
                          rdfs:subClassOf :ConceptualSocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#DisgustedFacialExpression
:DisgustedFacialExpression rdf:type owl:Class ;
                           rdfs:subClassOf :FacialExpression .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Dislike
:Dislike rdf:type owl:Class ;
         rdfs:subClassOf :SocialExperienceRating .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#EmotionVector
:EmotionVector rdf:type owl:Class ;
               rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute> ;
               rdfs:comment "A class for the representation of emotions as a vector of scalar values." .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#EmotionalState
:EmotionalState rdf:type owl:Class ;
                rdfs:subClassOf :CognitiveSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ExhibitSelfControlSocialAbility
:ExhibitSelfControlSocialAbility rdf:type owl:Class ;
                                 rdfs:subClassOf :ConceptualSocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ExpressEmpathySocialAbility
:ExpressEmpathySocialAbility rdf:type owl:Class ;
                             rdfs:subClassOf :ConceptualSocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ExtrinsicSocialParameter
:ExtrinsicSocialParameter rdf:type owl:Class ;
                          rdfs:subClassOf :SocialParameter ;
                          owl:disjointWith :IntrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#FacialExpression
:FacialExpression rdf:type owl:Class ;
                  rdfs:subClassOf :EmotionVector ;
                  rdfs:comment "Disjoint facial expressions. If one is identified as the truth, the others do not comply!" .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#FearfulFacialExpression
:FearfulFacialExpression rdf:type owl:Class ;
                         rdfs:subClassOf :FacialExpression .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#GainTrustSocialAbility
:GainTrustSocialAbility rdf:type owl:Class ;
                        rdfs:subClassOf :ConceptualSocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Gaze
:Gaze rdf:type owl:Class ;
      rdfs:subClassOf :SensorialSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#GazedEntitySet
:GazedEntitySet rdf:type owl:Class ;
                rdfs:subClassOf :SocialEntitySet .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Gesture
:Gesture rdf:type owl:Class ;
         rdfs:subClassOf :PhysicalSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#HappyFacialExpression
:HappyFacialExpression rdf:type owl:Class ;
                       rdfs:subClassOf :FacialExpression .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#HumanSocialAbility
:HumanSocialAbility rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :SocialAbility
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf> ;
                                                                 owl:someValuesFrom <http://pst.istc.cnr.it/ontologies/2019/01/soho#Human>
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#HumanSocialParameter
:HumanSocialParameter rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :SocialParameter
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf> ;
                                                                   owl:someValuesFrom <http://pst.istc.cnr.it/ontologies/2019/01/soho#Human>
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Indifferent
:Indifferent rdf:type owl:Class ;
             rdfs:subClassOf :SocialExperienceRating .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#IntrinsicSocialParameter
:IntrinsicSocialParameter rdf:type owl:Class ;
                          rdfs:subClassOf :SocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Lighting
:Lighting rdf:type owl:Class ;
          rdfs:subClassOf :ExtrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Like
:Like rdf:type owl:Class ;
      rdfs:subClassOf :SocialExperienceRating .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#NeutralFacialExpression
:NeutralFacialExpression rdf:type owl:Class ;
                         rdfs:subClassOf :FacialExpression .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Noise
:Noise rdf:type owl:Class ;
       rdfs:subClassOf :ExtrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#NoiseVolume
:NoiseVolume rdf:type owl:Class ;
             rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#PhysicalSocialParameter
:PhysicalSocialParameter rdf:type owl:Class ;
                         rdfs:subClassOf :IntrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#PhysiologicalSocialParameter
:PhysiologicalSocialParameter rdf:type owl:Class ;
                              rdfs:subClassOf :IntrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ReachableEntitySet
:ReachableEntitySet rdf:type owl:Class ;
                    rdfs:subClassOf :SocialEntitySet .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#RobotSocialAbility
:RobotSocialAbility rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :SocialAbility
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#isQualityOf> ;
                                                                 owl:someValuesFrom <http://pst.istc.cnr.it/ontologies/2019/01/soho#Cobot>
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#RobotSocialParameter
:RobotSocialParameter rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :SocialParameter
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#isPartOf> ;
                                                                   owl:someValuesFrom <http://pst.istc.cnr.it/ontologies/2019/01/soho#Cobot>
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SadFacialExpression
:SadFacialExpression rdf:type owl:Class ;
                     rdfs:subClassOf :FacialExpression .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SensedEntitySet
:SensedEntitySet rdf:type owl:Class ;
                 rdfs:subClassOf :SocialEntitySet .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SensorialSocialParameter
:SensorialSocialParameter rdf:type owl:Class ;
                          rdfs:subClassOf :IntrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ShowAssertivitySocialAbility
:ShowAssertivitySocialAbility rdf:type owl:Class ;
                              rdfs:subClassOf :ConceptualSocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ShowCompetenceSocialAbility
:ShowCompetenceSocialAbility rdf:type owl:Class ;
                             rdfs:subClassOf :ConceptualSocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#ShowResponsibitlitySocialAbility
:ShowResponsibitlitySocialAbility rdf:type owl:Class ;
                                  rdfs:subClassOf :ConceptualSocialAbility .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SocialAbility
:SocialAbility rdf:type owl:Class ;
               rdfs:subClassOf <http://pst.istc.cnr.it/ontologies/2019/01/soho#Capability> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasRegion> ;
                                 owl:someValuesFrom :SocialExperienceRating
                               ] ;
               rdfs:comment "Social abilites as part of an agent's capability." .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SocialAgentBehavior
:SocialAgentBehavior rdf:type owl:Class ;
                     rdfs:subClassOf <http://pst.istc.cnr.it/ontologies/2019/01/soho#AgentBehavior> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent> ;
                                       owl:someValuesFrom :SocialAbility
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasRegion> ;
                                       owl:someValuesFrom :SocialExperienceRating
                                     ] .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SocialEntitySet
:SocialEntitySet rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute> ;
                 rdfs:comment "Represents statistical values over a collection of entities with some defined form of social relevancy" .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SocialExperienceRating
:SocialExperienceRating rdf:type owl:Class ;
                        rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Region> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SocialFunction
:SocialFunction rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( <http://pst.istc.cnr.it/ontologies/2019/01/soho#Function>
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasEffectOn> ;
                                                             owl:someValuesFrom :SocialAbility
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasRegion> ;
                                  owl:someValuesFrom :SocialExperienceRating
                                ] .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SocialParameter
:SocialParameter rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Parameter> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#classifies> ;
                                   owl:allValuesFrom <http://www.loa-cnr.it/ontologies/DUL.owl#SocialObjectAttribute>
                                 ] .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#SurprisedFacialExpression
:SurprisedFacialExpression rdf:type owl:Class ;
                           rdfs:subClassOf :FacialExpression .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#Temperature
:Temperature rdf:type owl:Class ;
             rdfs:subClassOf :ExtrinsicSocialParameter .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#TouchedEntitySet
:TouchedEntitySet rdf:type owl:Class ;
                  rdfs:subClassOf :SocialEntitySet .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#VisualSocialParameter
:VisualSocialParameter rdf:type owl:Class ;
                       rdfs:subClassOf :IntrinsicSocialParameter .


#################################################################
#    Individuals
#################################################################

###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#assemble1
:assemble1 rdf:type owl:NamedIndividual ,
                    <http://pst.istc.cnr.it/ontologies/2019/01/soho#Assembly> ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#canBeAssignedTo> :worker ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#canBePerformedBy> :worker ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasTarget> :assembly-part1 ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#requires> :assembly-part2 ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasDuration> "10.0"^^xsd:float ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasDurationUncertainty> "10.0"^^xsd:float ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasGoal> "assembly-part1" ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasProcedureName> "Assemble1" .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#assemble2
:assemble2 rdf:type owl:NamedIndividual ,
                    <http://pst.istc.cnr.it/ontologies/2019/01/soho#Assembly> ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#canBeAssignedTo> :worker ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#canBePerformedBy> :worker ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasTarget> :assembly-part1 ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#requires> :assembly-part3 ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasDuration> "10.0"^^xsd:float ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasDurationUncertainty> "10.0"^^xsd:float ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasGoal> "assembly-part1" ;
           <http://pst.istc.cnr.it/ontologies/2019/01/soho#hasProcedureName> "Assemble2" .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#assembled-product
:assembled-product rdf:type owl:NamedIndividual ,
                            <http://pst.istc.cnr.it/ontologies/2019/01/soho#CompoundWorkPiece> ;
                   <http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent> :assembly-part1 ,
                                                                             :assembly-part2 ,
                                                                             :assembly-part3 .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#assembly-part1
:assembly-part1 rdf:type owl:NamedIndividual ,
                         <http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleWorkpiece> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#assembly-part2
:assembly-part2 rdf:type owl:NamedIndividual ,
                         <http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleWorkpiece> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#assembly-part3
:assembly-part3 rdf:type owl:NamedIndividual ,
                         <http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleWorkpiece> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#box1
:box1 rdf:type owl:NamedIndividual ,
               <http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleWorkpiece> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#box2
:box2 rdf:type owl:NamedIndividual ,
               <http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleWorkpiece> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#box3
:box3 rdf:type owl:NamedIndividual ,
               <http://pst.istc.cnr.it/ontologies/2019/01/soho#SimpleWorkpiece> .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#doAssembly
:doAssembly rdf:type owl:NamedIndividual ,
                     <http://pst.istc.cnr.it/ontologies/2019/01/soho#ConjunctiveComplexTask> ;
            <http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent> :doAssemblyPart1Part2 ,
                                                                      :doCollaborativeAssemblyPart1Part3 ,
                                                                      :thankRobot .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#doAssemblyPart1Part2
:doAssemblyPart1Part2 rdf:type owl:NamedIndividual ,
                               <http://pst.istc.cnr.it/ontologies/2019/01/soho#DisjunctiveComplexTask> ;
                      <http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent> :doCollaborativeAssemblyPart1Part2Spot1 ,
                                                                                :doCollaborativeAssemblyPart1Part2Spot2 ,
                                                                                :doCollaborativeAssemblyPart1Part2Spot3 .


###  https://www.uni-augsburg.de/de/fakultaet/fai/informatik/prof/pi/projekte/forschung/forsocialrobots/sobots#doCollaborativeAssemblyPart1Part2Spot1
:doCollaborativeAssemblyPart1Part2Spot1 rdf:type owl:NamedIndividual ,
                                                 <http://pst.istc.cnr.it/ontologies/2019/01/soho#SimultaneousHRCTask> ;
                                        <http://www.loa-cnr.it/ontologies/DUL.owl#hasConstituent> :assemble1 ,
                                                                                                  :pickplace-box1-spot1 ,
                                                                                                  :pickplace-box2-spot1 .


