    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MozzarellaTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MozzarellaTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheeseTopping"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#ParmesanTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MushroomTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MushroomTopping">
