                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozzarella and Tomato, and Pepperoni toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AnchovyTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AnchovyTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#SeafoodTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CaperTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CaperTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheeseTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheeseTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheesyPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheesyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#CheeseTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#GreenPepperTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#GreenPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PepperTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#HamTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#HamTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MeatTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#HighCaloriePizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#HighCaloriePizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasCaloricContent"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#InterestingPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#InterestingPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PizzaTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#JalapenoPepperTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#JalapenoPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PepperTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasSpiciness"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Hot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#LowCaloriePizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#LowCaloriePizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasCaloricContent"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400</xsd:maxExclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MargheritaPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MargheritaPizza">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MozzarellaTopping"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#TomatoTopping"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozzarella and Tomato toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MeatTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MeatTopping">
