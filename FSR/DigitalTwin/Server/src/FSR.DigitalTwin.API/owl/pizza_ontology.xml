     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:pizza-tutorial="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasBase -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasBase">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isBaseOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PizzaBase"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasIngredient">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasSpiciness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasSpiciness">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PizzaTopping"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Spiciness"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isToppingOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PizzaTopping"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isBaseOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isBaseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isIngredientOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isIngredientOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isIngredientOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isMilderThan -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isMilderThan">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isSpicierThan"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isSpicierThan -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isSpicierThan">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Spiciness"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Spiciness"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isToppingOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isToppingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#isIngredientOf"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasCaloricContent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasCaloricContent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#Pizza"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AmericanaHotPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AmericanaHotPizza">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozzarella and Tomato, and Pepperoni toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AmericanaPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#AmericanaPizza">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/raoul/ontologies/2025/0/pizza-tutorial#NamedPizza"/>
